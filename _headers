# Content-hash filenames (media/、previews/) never change → cache forever.
# index.html、app.js、manifest.json 等每次发布都会变的文件保持默认(max-age=0),
# 确保新部署立即生效,这里不需要覆盖。

# 素材目录：data/<主题>/<分区>/，内容寻址，长期缓存
/data/*
  Cache-Control: public, max-age=31536000, immutable

/previews/*
  Cache-Control: public, max-age=31536000, immutable

# 灯箱大图层: 同样由 make_previews.py 生成,文件名稳定,缓存永久
/large/*
  Cache-Control: public, max-age=31536000, immutable

# 稳定文件名的品牌素材: 缓存 10 分钟。
# 注意(踩过的坑): 这几条原本是 7 天(604800), 导致换立绘/logo 后老访客长期看到旧图;
# 更糟的是若某次部署期间文件 404, 浏览器会把"失败结果"按 7 天缓存下来,
# 之后服务器恢复了访客页面依旧空白, 必须手动强刷才能好。10 分钟内可自愈。
/logo/*
  Cache-Control: public, max-age=600

/assets/*
  Cache-Control: public, max-age=600

/memes/*
  Cache-Control: public, max-age=600

# 背景音乐（music/bgm.m4a，约 4.9 MB）：文件名固定 → 不设 immutable。
# 同样给 10 分钟：换歌后老访客最多 10 分钟自愈，不需要强刷（理由同上面品牌素材）。
/music/*
  Cache-Control: public, max-age=600
